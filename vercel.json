{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "installCommand": "npm install",
  "framework": "vite",
  "rewrites": [
    { "source": "/", "destination": "/index.html" },
    { "source": "/about", "destination": "/about/index.html" },
    { "source": "/service", "destination": "/service/index.html" },
    { "source": "/portfolio", "destination": "/portfolio/index.html" },
    { "source": "/partnership", "destination": "/partnership/index.html" },
    { "source": "/contact", "destination": "/contact/index.html" },
    { "source": "/join-us", "destination": "/join-us/index.html" },
    { "source": "/cgu", "destination": "/cgu/index.html" },
    { "source": "/confidentialite", "destination": "/confidentialite/index.html" },
    { "source": "/securite", "destination": "/securite/index.html" },
    { "source": "/((?!assets/).*)", "destination": "/spa.html" }
  ]
}
